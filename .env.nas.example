# ============================================================
# Tobi Homepage NAS 部署环境变量
# 复制为 .env.nas（不入库）后填写
# ============================================================

# NAS 自建 Supabase（REST 网关）
COZE_SUPABASE_URL=http://192.168.31.110:8000
COZE_SUPABASE_ANON_KEY=your-anon-key

# 文件存储：NAS 本地文件（compose 中已设置 STORAGE_TYPE=local、DATA_STORAGE_PATH=/app/data）
# 上传的图片保存在宿主机 /volume2/docker/home-tobi/data，无需 COZE_BUCKET_*

# frp 内网穿透鉴权 token（frpc.toml 中通过 {{ .Envs.FRP_TOKEN }} 引用）
FRP_TOKEN=your-frp-token
